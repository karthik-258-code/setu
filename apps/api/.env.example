# Copy to .env (git-ignored). Matches the postgres service in ../../docker-compose.yml.
DATABASE_URL="postgresql://setu:setu@localhost:5432/setu?schema=public"
# Signs access and refresh tokens (Phase 4). Use a long random value outside local dev.
JWT_SECRET="change-me-in-production"
# Optional: HTTP listen port (default 3000) and host (default 0.0.0.0).
# PORT=3000
# HOST=0.0.0.0
