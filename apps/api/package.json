{
  "name": "@setu/api",
  "version": "0.1.0",
  "private": true,
  "description": "Setu API: Fastify, Prisma and PostgreSQL. Thin service for auth, packs, sync and teacher views.",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --external:fastify --external:@prisma/client --external:zod",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx src/seed.ts",
    "db:import": "node --import tsx src/import-roster.ts",
    "postinstall": "prisma generate",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@setu/engine": "workspace:*",
    "@setu/shared": "workspace:*",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "esbuild": "^0.21.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
