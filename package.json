{
  "name": "setu",
  "version": "0.1.0",
  "private": true,
  "description": "Setu: teacher-centred, offline-first adaptive learning for Classes 6 to 10 (Code Kernel '26)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "content:validate": "pnpm --filter @setu/content validate",
    "content:pack": "pnpm --filter @setu/content pack",
    "sim": "pnpm --filter @setu/engine sim"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
