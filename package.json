{
  "name": "setu",
  "version": "0.1.0",
  "private": true,
  "description": "Setu: teacher-centred, offline-first adaptive learning for Classes 6 to 10 (Code Kernel '26)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "content:validate": "node scripts/run-if-present.mjs packages/content @setu/content validate",
    "content:pack": "node scripts/run-if-present.mjs packages/content @setu/content pack",
    "sim": "pnpm --filter @setu/engine sim",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "type": "module"
}
