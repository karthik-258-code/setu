{
  "name": "setu",
  "version": "0.1.0",
  "private": true,
  "description": "Setu: teacher-centred, offline-first adaptive learning for Classes 6 to 10 (Code Kernel '26)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm content:pack && pnpm -r build",
    "build:capacitor": "pnpm content:pack && pnpm --filter @setu/web run build:capacitor",
    "cap:add:android": "pnpm run build:capacitor && pnpm --filter @setu/web run cap:add:android",
    "cap:sync": "pnpm content:pack && pnpm --filter @setu/web run cap:sync",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "content:validate": "pnpm --filter @setu/content run validate",
    "content:pack": "pnpm --filter @setu/content run pack",
    "sim": "pnpm --filter @setu/content sim",
    "sim:export": "pnpm --filter @setu/content run export-sim",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "type": "module"
}
