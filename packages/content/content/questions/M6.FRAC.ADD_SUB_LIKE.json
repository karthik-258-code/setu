  {"id": "M6.FRAC.ADD_SUB_LIKE.Q05", "conceptId": "M6.FRAC.ADD_SUB_LIKE", "type": "mcq", "difficulty": 3,
   "stem": {"en": "Anjali ate 2/9 of a cake and Ravi ate 4/9 of it. What fraction of the cake is left?", "te": "అంజలి ఒక కేకులో 2/9 వంతు, రవి 4/9 వంతు తిన్నారు. కేకులో ఎంత భిన్నం మిగిలింది?"},
   "options": [
     {"id": "a", "text": {"en": "2/3", "te": "2/3"}, "isCorrect": false},
     {"id": "b", "text": {"en": "6/18", "te": "6/18"}, "isCorrect": false, "misconceptionCode": "F-ADD-DENOM"},
     {"id": "c", "text": {"en": "1/9", "te": "1/9"}, "isCorrect": false},
     {"id": "d", "text": {"en": "1/3", "te": "1/3"}, "isCorrect": true}],
   "solution": {"en": "They ate 2/9 + 4/9 = 6/9. Left: 9/9 - 6/9 = 3/9 = 1/3.", "te": "వారు తిన్నది 2/9 + 4/9 = 6/9. మిగిలింది: 9/9 - 6/9 = 3/9 = 1/3."},
   "boardTags": ["NCERT", "TS_SCERT"], "tags": ["word_problem"], "reviewStatus": "draft"},
