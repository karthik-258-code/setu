  {"id": "M7.INT.PROPERTIES.Q01", "conceptId": "M7.INT.PROPERTIES", "type": "mcq", "difficulty": 1,
   "stem": {"en": "Which property says -5 + 8 = 8 + (-5)?", "te": "-5 + 8 = 8 + (-5) అని ఏ ధర్మం చెబుతుంది?"},
   "options": [
