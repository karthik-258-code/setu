   "stem": {"en": "What is the degree of 3x² - 5x + 2?", "te": "3x² - 5x + 2 పరిమాణం ఎంత?"},
   "options": [
     {"id": "a", "text": {"en": "1", "te": "1"}, "isCorrect": false},
