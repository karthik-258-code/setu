{
  "name": "@setu/content",
  "version": "0.1.0",
  "private": true,
  "description": "Setu content: concept graph, questions, resources, zod schemas, validator and pack builder.",
  "type": "module",
  "main": "./src/schema.ts",
  "types": "./src/schema.ts",
  "exports": {
    ".": "./src/schema.ts"
  },
  "scripts": {
    "validate": "node --import tsx src/validate.ts",
    "pack": "node --import tsx src/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@setu/engine": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
